{
  "cli": {
    "version": ">= 16.20.1",
    "appVersionSource": "remote"
  },
  "build": {
    "dev": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "prod": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    },
    "development": {
      "extends": "dev"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "preview-android": {
      "extends": "preview",
      "credentialsSource": "local"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "production-android": {
      "extends": "production",
      "credentialsSource": "local",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "prod": {
      "ios": {
        "ascAppId": "6790596334"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6790596334"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "alpha"
      }
    }
  }
}
